# Claude Code 本地配置（不纳入版本控制）
.claude/

# 构建输出
dist/
target/

# 操作系统文件
.DS_Store
Thumbs.db
Desktop.ini

# IDE / 编辑器
.idea/
.vscode/
*.swp
*.swo
*~

# 版本快照（ucx version auto 自动生成）
.ucx-snapshot.json

# 测试临时目录（黑盒回归测试的可再生 scratch：二进制、测试密钥、样本数据等）
# 正式测试报告已归档至 docs/test/problems/，此目录无需纳入版本控制
temp_test/

# 多语言 SDK：每个 sdk/<lang>/ 作为 git submodule 引用独立开源仓库。
# 父仓库通过 .gitmodules 跟踪各 SDK 的 commit 引用（GitHub 显示为蓝色链接目录）。
